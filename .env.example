# =============================================================================
# Environment Variables for OCR Spelling Correction System
# =============================================================================
# Copy this file to .env and fill in your values.
# These are optional — the application works with sensible defaults.
# =============================================================================

# Flask secret key (used for session security; change in production)
SECRET_KEY=change-me-in-production

# Maximum upload size in bytes (default: 16 MB)
# MAX_CONTENT_LENGTH=16777216
